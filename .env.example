# ──────────────────────────────────────────────────────────────
# AdSpace — variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# ──────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Neon, Supabase, Railway, RDS o local).
# DATABASE_URL: conexión usada por la app (puede ser pooled, ej. PgBouncer).
# DIRECT_URL: conexión directa usada por Prisma para migraciones.
DATABASE_URL="postgresql://adspace:adspace@localhost:5432/adspace?schema=public"
DIRECT_URL="postgresql://adspace:adspace@localhost:5432/adspace?schema=public"

# Secreto para firmar las sesiones (JWT HS256). Mínimo 32 caracteres.
# Generalo con: openssl rand -base64 48
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# URL pública de la app (se usa en enlaces absolutos y callbacks de pago).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comisión de la plataforma por contratación concretada (0.15 = 15%).
PLATFORM_COMMISSION_RATE="0.15"

# Cloudinary (recomendado). Si no se configura, las imágenes se guardan en el
# disco local (LOCAL_UPLOAD_DIR, por defecto ./uploads) y se sirven desde
# /api/uploads. En producción esto requiere ALLOW_LOCAL_UPLOADS="true" y un
# disco persistente; en plataformas serverless (Vercel) usá Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="adspace"
# LOCAL_UPLOAD_DIR="/var/data/adspace-uploads"
ALLOW_LOCAL_UPLOADS="false"

# Pasarela de pagos. Valores: "manual" (por defecto, sin cobro real).
# Fase siguiente: "mercadopago" (requiere MERCADOPAGO_ACCESS_TOKEN).
PAYMENT_PROVIDER="manual"
MERCADOPAGO_ACCESS_TOKEN=""
