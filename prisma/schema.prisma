// AdSpace — modelo de datos
// Montos en pesos argentinos (ARS) enteros, sin centavos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADVERTISER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SpaceStatus {
  DRAFT
  PENDING
  PUBLISHED
  PAUSED
  REJECTED
}

enum Visibility {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum BookingStatus {
  PENDING // solicitud enviada, en negociación
  ACCEPTED // acuerdo alcanzado, pendiente de pago / instalación
  ACTIVE // instalada y en curso
  COMPLETED // finalizada
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EvidenceType {
  INSTALLATION
  COMPLETION
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  companyName  String?
  phone        String?
  city         String?
  bio          String?
  avatarUrl    String?
  verified     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  spaces              Space[]
  bookingsAsAdvertiser Booking[]      @relation("AdvertiserBookings")
  bookingsAsOwner      Booking[]      @relation("OwnerBookings")
  offers               BookingOffer[]
  bookingEvents        BookingEvent[]
  evidences            Evidence[]
  messages             Message[]
  conversationsAsOwner      Conversation[] @relation("OwnerConversations")
  conversationsAsAdvertiser Conversation[] @relation("AdvertiserConversations")
  reviewsWritten       Review[]       @relation("ReviewAuthor")
  reviewsReceived      Review[]       @relation("ReviewTarget")
  reportsMade          Report[]       @relation("Reporter")
  reportsAgainst       Report[]       @relation("ReportedUser")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String // nombre de ícono lucide
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  // Multiplicador usado por el estimador de potencial comercial
  priceFactor Float    @default(1)
  spaces      Space[]
}

model Space {
  id               String      @id @default(cuid())
  ownerId          String
  categoryId       String
  title            String
  description      String
  // Ubicación: la dirección exacta es privada; se publican coordenadas aproximadas.
  city             String
  province         String
  neighborhood     String?
  addressPrivate   String?
  lat              Float
  lng              Float
  widthM           Float
  heightM          Float
  surfaceType      String
  visibility       Visibility
  dailyImpressions Int // audiencia diaria estimada
  pricePerMonth    Int
  minMonths        Int         @default(1)
  availableFrom    DateTime
  availableTo      DateTime?
  conditions       String?
  includesInstallation Boolean @default(false)
  status           SpaceStatus @default(DRAFT)
  featured         Boolean     @default(false)
  rejectionReason  String?
  views            Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  publishedAt      DateTime?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  images        SpaceImage[]
  bookings      Booking[]
  conversations Conversation[]
  reports       Report[]

  @@index([status, city])
  @@index([categoryId])
  @@index([ownerId])
}

model SpaceImage {
  id        String  @id @default(cuid())
  spaceId   String
  url       String
  publicId  String? // id en Cloudinary, para poder eliminarla
  sortOrder Int     @default(0)
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

model Booking {
  id               String        @id @default(cuid())
  spaceId          String
  advertiserId     String
  ownerId          String
  campaignName     String
  startDate        DateTime
  endDate          DateTime
  months           Int
  monthlyPrice     Int // precio mensual vigente (última propuesta)
  totalAmount      Int
  commissionRate   Float
  commissionAmount Int
  ownerPayout      Int
  status           BookingStatus @default(PENDING)
  // Quién debe responder la última propuesta
  awaitingUserId   String?
  agreementText    String? // snapshot de los términos al aceptar
  acceptedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  space      Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  advertiser User           @relation("AdvertiserBookings", fields: [advertiserId], references: [id])
  owner      User           @relation("OwnerBookings", fields: [ownerId], references: [id])
  offers     BookingOffer[]
  events     BookingEvent[]
  evidences  Evidence[]
  payments   Payment[]
  reviews    Review[]

  @@index([advertiserId])
  @@index([ownerId])
  @@index([spaceId, status])
}

model BookingOffer {
  id           String   @id @default(cuid())
  bookingId    String
  authorId     String
  monthlyPrice Int
  note         String?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  actorId   String?
  type      String
  note      String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])
}

model Evidence {
  id           String       @id @default(cuid())
  bookingId    String
  uploadedById String
  type         EvidenceType
  url          String
  note         String?
  createdAt    DateTime     @default(now())
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
}

// Registro de pagos. No procesa dinero real: la integración con la pasarela
// se conecta mediante src/lib/payments (proveedor "manual" por defecto).
model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  amount           Int
  commissionAmount Int
  provider         String        @default("manual")
  providerRef      String?
  checkoutUrl      String?
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String    @id @default(cuid())
  spaceId      String
  ownerId      String
  advertiserId String
  lastMessageAt DateTime @default(now())
  createdAt    DateTime  @default(now())
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner        User      @relation("OwnerConversations", fields: [ownerId], references: [id])
  advertiser   User      @relation("AdvertiserConversations", fields: [advertiserId], references: [id])
  messages     Message[]

  @@unique([spaceId, advertiserId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  authorId  String
  targetId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([bookingId, authorId])
  @@index([targetId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  spaceId        String?
  reportedUserId String?
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime     @default(now())
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  space          Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
}
